# Copy file nay thanh .env (cung thu muc voi package.json hoac dat canh Duck ai Manager.exe)
# Tuyet doi KHONG commit file .env chua API key that len Git.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
OLLAMA_MODEL=qwen2.5:1.5b

# Tuy chon: Google OAuth 2.0 (Desktop App) & Backend Online (cloud-hub-backend)
# App van chay offline binh thuong khi de trong (che do Offline/Guest)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLOUD_HUB_API_URL=http://127.0.0.1:8787
