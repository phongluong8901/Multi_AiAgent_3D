# Copy this file to .env and fill in your API keys (never commit .env!)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: comma-separated extra Gemini keys for rotation
GEMINI_API_KEYS=

# Groq Free Tier (OpenAI-compatible, fast Llama 3.3 70B / Qwen3 32B)
GROQ_API_KEY=

# Cloudflare Workers AI Free Tier (10,000 Neurons/day)
CLOUDFLARE_API_TOKEN=
# Optional: auto-discovered if token has Account:Read permission
CLOUDFLARE_ACCOUNT_ID=

# Router strategy: priority | round_robin
LLM_ROUTER_STRATEGY=priority

