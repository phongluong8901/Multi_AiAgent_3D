# ==========================================
# Google Gemini API
# ==========================================
GOOGLE_API_KEY=your_gemini_api_key_here
FAST_MODEL=gemini-1.5-flash

# ==========================================
# Search API (Tavily: https://app.tavily.com)
# ==========================================
TAVILY_API_KEY=your_tavily_api_key_here

# ==========================================
# LangSmith (Observability & Tracing)
# ==========================================
LANGSMITH_TRACING=true
LANGCHAIN_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=agent-selflearn
LANGCHAIN_PROJECT=agent-selflearn

# ==========================================
# Service URLs & Endpoints
# ==========================================
# Qdrant Vector DB (dùng http://qdrant:6333 khi chạy Docker, http://localhost:6333 khi chạy local)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Redis (dùng redis://redis:6379/0 khi chạy Docker, redis://localhost:6379/0 khi chạy local)
REDIS_URL=redis://redis:6379/0

# AI Core Service URL (Gateway gọi AI Core)
AI_CORE_URL=http://ai-core:8000

# Gateway Internal URL (AI Core gọi webhook Gateway)
GATEWAY_INTERNAL_URL=http://gateway:4000

# Gateway Service URL (Frontend gọi Gateway qua browser)
VITE_GATEWAY_URL=http://localhost:4000

# Service Ports
AI_CORE_PORT=8000
GATEWAY_PORT=4000
FRONTEND_PORT=3001
