# Cổng chạy Backend Express & WebSocket
PORT=4000

# API Key miễn phí từ Groq (Được dùng khi tích hợp LangChain / LLM)
# Lấy Key tại: https://console.groq.com/keys
GROQ_API_KEY=

# Mở tính năng Tracing của LangChain / LangGraph
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT="multi agent 3d"

# (Tùy chọn) Nút cấu hình môi trường
NODE_ENV=development