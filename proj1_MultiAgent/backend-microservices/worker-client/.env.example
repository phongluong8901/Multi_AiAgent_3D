# WebSocket URL của Distributed Service
WS_URL=ws://localhost:4000/api/v1/distributed/ws

# Mã Auth Token xác thực đối tác
AUTH_TOKEN=dist_seller_local_node

# ID nhận diện Node đối tác
NODE_ID=node_seller_pc

# Đường dẫn URL tới máy chủ Ollama LLM cục bộ
OLLAMA_URL=http://localhost:11434

# Giới hạn tài nguyên
ALLOCATED_CORES=4
ALLOCATED_RAM_GB=8
ENABLE_GPU=true
GPU_SHARE_PERCENT=80
MIN_PRICE_PER_HOUR=35.0
TELEMETRY_INTERVAL=2.0

