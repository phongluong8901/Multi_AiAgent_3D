{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "ComputeStudio",
    "version": "0.1.0",
    "identifier": "com.computestudio.app",
    "build": {
        "beforeDevCommand": "npm --prefix frontend run dev",
        "devUrl": "http://localhost:5173",
        "beforeBuildCommand": "npm --prefix frontend run build",
        "frontendDist": "../frontend/dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Compute Studio Workbench",
                "width": 1360,
                "height": 850,
                "minWidth": 900,
                "minHeight": 600,
                "decorations": false,
                "center": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": false,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/icon.ico"
        ],
        "externalBin": [
            "binaries/backend-engine"
        ]
    }
}
